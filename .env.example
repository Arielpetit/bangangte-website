# Copier en .env.local et remplir avec les valeurs de Supabase : Project Settings > API.
# URL du projet, sans /rest/v1 à la fin (ex. https://abcdefgh.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique (anon / publishable) : utilisée par le site et le tableau de bord, protégée par les règles RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète (service_role / secret) : serveur uniquement (invitations, chargement du contenu de départ). Ne jamais la publier.
SUPABASE_SERVICE_ROLE_KEY=
# Adresse publique du site (liens de partage, métadonnées)
NEXT_PUBLIC_SITE_URL=https://bangangte.skyengpro.site
