{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bangangte-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Fichiers statiques et pages pré-rendues produits par « opennextjs-cloudflare build ».
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "bangangte-site" }],
  // Adresse publique : l'enregistrement DNS et le certificat existent déjà.
  "routes": [{ "pattern": "bangangte.skyengpro.site", "custom_domain": true }],
  // Variables publiques (clé anonyme Supabase). La clé service_role se met en secret :
  //   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
  "vars": {},
  "observability": { "enabled": true }
}
