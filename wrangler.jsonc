{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bangangte-site",
  "compatibility_date": "2026-10-06",
  // Fichiers statiques générés par « next build » (output: "export").
  "assets": { "directory": "./out", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" },
  // Adresse publique : l'enregistrement DNS et le certificat sont créés au déploiement.
  "routes": [{ "pattern": "bangangte.skyengpro.site", "custom_domain": true }],
  "observability": { "enabled": true }
}
